{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://njutest.dev/schema/rust-mutants-carried-v1.json",
  "title": "rust-mutants carried v1",
  "description": "Every carried record a run believed: an answer from an earlier tree, filed under the mutation's locus, with every execution it rests on. An audit holds each one to this run's skeletons, item bodies and route. The rule is in docs/engine/carry.md; ADR 0041 is why it exists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "schema_version",
    "records"
  ],
  "properties": {
    "document_type": {
      "const": "rust-mutants/carried"
    },
    "schema_version": {
      "const": 1
    },
    "records": {
      "description": "Each believed record, by the full identity of the mutant it answered for, in the order of those identities.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/believed"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "path",
        "ordinal"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "believed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutant",
        "record",
        "plan"
      ],
      "properties": {
        "mutant": {
          "$ref": "#/$defs/digest"
        },
        "record": {
          "$ref": "#/$defs/record"
        },
        "plan": {
          "description": "The executions this run's route would have made, which the record was held to.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "filter"
            ],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "filter": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "locus",
        "keyed",
        "outcome",
        "target",
        "tests_run",
        "failed_tests",
        "run_id",
        "executions"
      ],
      "properties": {
        "schema": {
          "const": "rust-mutants-carried-v1"
        },
        "locus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item",
            "body_digest",
            "start",
            "end",
            "replacement",
            "rule"
          ],
          "properties": {
            "item": {
              "$ref": "#/$defs/item"
            },
            "body_digest": {
              "$ref": "#/$defs/digest"
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            },
            "replacement": {
              "type": "string"
            },
            "rule": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "keyed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "closure",
            "manifests",
            "toolchain",
            "engine",
            "args",
            "timeout",
            "steps",
            "build"
          ],
          "properties": {
            "closure": {
              "type": "string"
            },
            "manifests": {
              "type": "string"
            },
            "toolchain": {
              "type": "string"
            },
            "engine": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "timeout": {
              "type": "string"
            },
            "steps": {
              "type": "integer",
              "minimum": 0
            },
            "build": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "outcome": {
          "enum": [
            "killed",
            "survived"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "tests_run": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "failed_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "executions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/execution"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "filter",
        "skeleton",
        "entered",
        "completeness",
        "detected"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "filter": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "skeleton": {
          "$ref": "#/$defs/digest"
        },
        "entered": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "body_digest"
            ],
            "properties": {
              "item": {
                "$ref": "#/$defs/item"
              },
              "body_digest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "completeness": {
          "enum": [
            "whole",
            "up-to-first-failure",
            "cut"
          ]
        },
        "detected": {
          "type": "boolean"
        }
      }
    }
  }
}
