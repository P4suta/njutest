{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://njutest.dev/schema/rust-mutants-run-stream-v1.json",
  "title": "rust-mutants run stream v1",
  "description": "One JSON object per line, written as a run happens. Version 2 is closed: a reader rejects unknown event types and extra, missing, or ambiguous fields.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_name",
        "run_id",
        "schema",
        "selection",
        "tool_version",
        "type"
      ],
      "properties": {
        "type": {
          "const": "run-start"
        },
        "schema": {
          "const": "rust-mutants-run-stream-v1"
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "root_name": {
          "type": "string"
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "build",
            "exclude",
            "include",
            "mutant_steps",
            "operators",
            "packages",
            "tier"
          ],
          "properties": {
            "tier": {
              "enum": [
                "balanced",
                "strong",
                "all"
              ]
            },
            "operators": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "include": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "packages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "build": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mutant_steps": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "type"
      ],
      "properties": {
        "type": {
          "const": "phase-start"
        },
        "phase": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_ms",
        "phase",
        "type"
      ],
      "properties": {
        "type": {
          "const": "phase-end"
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed",
        "mutant",
        "total",
        "type"
      ],
      "properties": {
        "type": {
          "const": "mutant"
        },
        "completed": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "mutant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "column",
            "display_id",
            "duration_ms",
            "failed_tests",
            "family",
            "id",
            "index",
            "line",
            "not_run_reason",
            "outcome",
            "path",
            "retried",
            "lingered",
            "rule",
            "source_run_id",
            "step_notice",
            "target",
            "tests_run"
          ],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "display_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{20}$"
            },
            "rule": {
              "type": "string"
            },
            "family": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 0
            },
            "column": {
              "type": "integer",
              "minimum": 0
            },
            "outcome": {
              "enum": [
                "killed",
                "survived",
                "step_limit_reached",
                "waited",
                "inconclusive",
                "errored",
                "not_run"
              ]
            },
            "target": {
              "type": "string"
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0
            },
            "tests_run": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "failed_tests": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "step_notice": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "catalog",
                    "limit",
                    "mutant",
                    "nonce",
                    "observed"
                  ],
                  "properties": {
                    "nonce": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{32}$"
                    },
                    "catalog": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "mutant": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "limit": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "observed": {
                      "type": "integer",
                      "minimum": 2
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "retried": {
              "type": "boolean"
            },
            "lingered": {
              "type": "boolean"
            },
            "not_run_reason": {
              "enum": [
                "unreached",
                "discharged",
                "interrupted",
                "unselected",
                "stopped-early",
                "declined",
                null
              ]
            },
            "source_run_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "outcome"
                ],
                "properties": {
                  "outcome": {
                    "const": "step_limit_reached"
                  }
                }
              },
              "then": {
                "properties": {
                  "step_notice": {
                    "type": "object"
                  }
                }
              },
              "else": {
                "properties": {
                  "step_notice": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding",
        "type"
      ],
      "properties": {
        "type": {
          "const": "finding"
        },
        "finding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "detail",
            "kind",
            "mutant"
          ],
          "properties": {
            "kind": {
              "enum": [
                "surviving-mutant",
                "inconclusive-mutant",
                "step-limit-reached-mutant",
                "waited-mutant",
                "errored-mutant",
                "not-run-mutant",
                "unreached-mutant",
                "discharged-mutant",
                "stale-expectation",
                "unmatched-expectation",
                "unmatched-skip"
              ]
            },
            "mutant": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string"
                }
              ]
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accounting",
        "exit_code",
        "interrupted",
        "report",
        "score",
        "type"
      ],
      "properties": {
        "type": {
          "const": "run-end"
        },
        "exit_code": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            130
          ]
        },
        "interrupted": {
          "type": "boolean"
        },
        "accounting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cataloged",
            "declined",
            "discharged",
            "errored",
            "executed",
            "expected",
            "inconclusive",
            "killed",
            "not_run",
            "refused",
            "skipped",
            "step_limit_reached",
            "survived",
            "unreached",
            "waited"
          ],
          "properties": {
            "cataloged": { "type": "integer", "minimum": 0 },
            "refused": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 },
            "executed": { "type": "integer", "minimum": 0 },
            "killed": { "type": "integer", "minimum": 0 },
            "survived": { "type": "integer", "minimum": 0 },
            "step_limit_reached": { "type": "integer", "minimum": 0 },
            "waited": { "type": "integer", "minimum": 0 },
            "inconclusive": { "type": "integer", "minimum": 0 },
            "errored": { "type": "integer", "minimum": 0 },
            "not_run": { "type": "integer", "minimum": 0 },
            "unreached": { "type": "integer", "minimum": 0 },
            "discharged": { "type": "integer", "minimum": 0 },
            "declined": { "type": "integer", "minimum": 0 },
            "expected": { "type": "integer", "minimum": 0 }
          }
        },
        "score": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decided",
                "detected",
                "value"
              ],
              "properties": {
                "detected": { "type": "integer", "minimum": 0 },
                "decided": { "type": "integer", "minimum": 1 },
                "value": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            },
            { "type": "null" }
          ]
        },
        "report": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "remedy",
        "type"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "remedy": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  ]
}
