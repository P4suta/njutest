{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/P4suta/njutest/schema/njutest-wire-v1.json",
  "title": "njutest-wire-v1",
  "description": "One exchange over one seam, as an interposer recorded it. The stream is JSON Lines: one exact object per line. A catalogue of faults is derived from these records, so malformed lines are counted as unread rather than shortened away.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "exchange"],
  "properties": {
    "schema": {
      "const": "njutest-wire-v1"
    },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "seq", "during", "duration_ms", "spoken"],
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1,
          "description": "The capability the seam serves, as [resources.<name>] names it."
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "description": "Which exchange this is on that seam, from zero."
        },
        "during": {
          "type": ["string", "null"],
          "description": "The test that was running, or null where the run could not tell."
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "spoken": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "wire",
                "method",
                "path",
                "status",
                "request_bytes",
                "response_bytes",
                "body_bytes",
                "status_line"
              ],
              "properties": {
                "wire": { "const": "http" },
                "method": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "status": { "type": "integer", "minimum": 0, "maximum": 599 },
                "request_bytes": { "type": "integer", "minimum": 0 },
                "response_bytes": { "type": "integer", "minimum": 0 },
                "body_bytes": { "type": "integer", "minimum": 0 },
                "status_line": { "type": "string" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["wire", "request_bytes", "response_bytes"],
              "properties": {
                "wire": { "const": "raw" },
                "request_bytes": { "type": "integer", "minimum": 0 },
                "response_bytes": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        }
      }
    }
  }
}
