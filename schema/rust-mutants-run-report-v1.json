{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/P4suta/njutest/schema/rust-mutants-run-report-v1.json",
  "title": "rust-mutants run report v1",
  "description": "One completed mutation run: the complete candidate accounting, what was selected and compiler-validated, what the tests noticed, and every claim a reviewer declared in advance. A not_run/unselected row can be deliberately unvalidated. The score is a ratio over the mutants the run decided, never over the ones it could not.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "schema_version",
    "tool_version",
    "run",
    "workspace",
    "selection",
    "accounting",
    "score",
    "mutants",
    "rejections",
    "skips",
    "expectations",
    "findings"
  ],
  "properties": {
    "document_type": {
      "const": "rust-mutants/run-report"
    },
    "schema_version": {
      "const": 2
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "started_at",
        "finished_at",
        "duration_ms",
        "interrupted",
        "exit_code",
        "shard"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The run's identity, which is also its directory name under the report directory."
        },
        "started_at": {
          "type": "string",
          "minLength": 1
        },
        "finished_at": {
          "type": "string",
          "minLength": 1
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "interrupted": {
          "type": "boolean"
        },
        "exit_code": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            130
          ],
          "description": "0 every mutant was noticed, 1 something was not, 2 the run itself failed, 130 it was interrupted."
        },
        "shard": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"
            }
          ],
          "description": "Which part of the catalog the run was about, written K/N, and absent for the whole of it. The parts of one tree cut the same way, so a merge of them is what the whole would have written."
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_name",
        "toolchain",
        "workspace_digest",
        "catalog_digest",
        "platform"
      ],
      "properties": {
        "root_name": {
          "type": "string"
        },
        "toolchain": {
          "type": "string"
        },
        "workspace_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "catalog_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "arch",
            "target"
          ],
          "properties": {
            "os": {
              "type": "string"
            },
            "arch": {
              "type": "string"
            },
            "target": {
              "type": "string"
            }
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "operators",
        "include",
        "exclude",
        "packages",
        "build",
        "mutant_steps"
      ],
      "properties": {
        "tier": {
          "enum": [
            "balanced",
            "strong",
            "all"
          ]
        },
        "operators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "build": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mutant_steps": {
          "description": "The per-process guard-take allowance, or null when the bound is disabled.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cataloged",
        "refused",
        "skipped",
        "executed",
        "killed",
        "survived",
        "step_limit_reached",
        "waited",
        "inconclusive",
        "errored",
        "not_run",
        "unreached",
        "discharged",
        "expected"
      ],
      "properties": {
        "cataloged": {
          "type": "integer",
          "minimum": 0,
          "description": "The number of candidate rows in mutants, excluding compiler refusals. A not_run/unselected row makes no compiler-acceptance claim."
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "executed": {
          "type": "integer",
          "minimum": 0
        },
        "killed": {
          "type": "integer",
          "minimum": 0
        },
        "survived": {
          "type": "integer",
          "minimum": 0
        },
        "step_limit_reached": {
          "type": "integer",
          "minimum": 0,
          "description": "Executions that reached the configured guard-take allowance. This is not a detection and is excluded from the score and reusable outcome cache."
        },
        "waited": {
          "type": "integer",
          "minimum": 0,
          "description": "Mutants whose bound expired before anything finished. Not detected: nothing was established about them, in either direction."
        },
        "inconclusive": {
          "type": "integer",
          "minimum": 0
        },
        "errored": {
          "type": "integer",
          "minimum": 0
        },
        "not_run": {
          "type": "integer",
          "minimum": 0
        },
        "unreached": {
          "description": "Of the mutants that never ran, how many no measured target reaches. Absent in a report written before coverage routing existed.",
          "type": "integer",
          "minimum": 0
        },
        "discharged": {
          "description": "Of the mutants that never ran, how many a proof removed every target from.",
          "type": "integer",
          "minimum": 0
        },
        "expected": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "score": {
      "description": "Absent when the run decided nothing, which is not the same as a score of zero.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "detected",
            "decided",
            "value"
          ],
          "properties": {
            "detected": {
              "type": "integer",
              "minimum": 0
            },
            "decided": {
              "type": "integer",
              "minimum": 1
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "mutants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "id",
          "display_id",
          "path",
          "package",
          "family",
          "rule",
          "item",
          "rule_version",
          "line",
          "column",
          "start_byte",
          "end_byte",
          "source_digest",
          "original",
          "replacement",
          "outcome",
          "target",
          "exit_code",
          "duration_ms",
          "tests_run",
          "killed_by",
          "signal",
          "step_notice",
          "retried",
          "not_run_reason",
          "route",
          "identical",
          "expected",
          "unreached",
          "source_run_id"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "display_id": {
            "type": "string",
            "minLength": 1
          },
          "item": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "package": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "rule_version": {
            "type": "integer",
            "minimum": 0
          },
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "column": {
            "type": "integer",
            "minimum": 0
          },
          "start_byte": {
            "type": "integer",
            "minimum": 0
          },
          "end_byte": {
            "type": "integer",
            "minimum": 0
          },
          "source_digest": {
            "type": "string"
          },
          "original": {
            "type": "string"
          },
          "replacement": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "not_run",
              "killed",
              "survived",
              "step_limit_reached",
              "waited",
              "inconclusive",
              "errored"
            ]
          },
          "target": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "tests_run": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          },
          "killed_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "signal": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer"
              }
            ]
          },
          "step_notice": {
            "description": "The nonce-correlated runtime notice, present only for step_limit_reached.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["nonce", "catalog", "mutant", "limit", "observed"],
                "properties": {
                  "nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
                  "catalog": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "mutant": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "limit": {"type": "integer", "minimum": 1},
                  "observed": {"type": "integer", "minimum": 2}
                }
              }
            ]
          },
          "not_run_reason": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "unreached",
                  "discharged",
                  "interrupted",
                  "unselected",
                  "stopped-early"
                ]
              }
            ],
            "description": "Why execution did not occur. unselected may mean the scoped preparation deliberately omitted compiler validation and instrumentation for this candidate."
          },
          "identical": {
            "enum": [
              "not-measured",
              "identical",
              "different",
              "not-established"
            ],
            "description": "What the optional compiler-artifact comparison established. Identity is never a claim that the mutation is semantically equivalent."
          },
          "route": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "granularity",
                  "fallback",
                  "reaching",
                  "discharged",
                  "executed",
                  "tests"
                ],
                "properties": {
                  "granularity": {
                    "enum": [
                      "all",
                      "test",
                      "block",
                      "discharged",
                      "unreached"
                    ]
                  },
                  "fallback": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "reaching": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "discharged": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "target",
                        "proof"
                      ],
                      "properties": {
                        "target": {
                          "type": "string"
                        },
                        "proof": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "executed": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "tests": {
                    "description": "For each target the measurement narrowed to some of its tests, exactly those tests.",
                    "type": "object",
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            ]
          },
          "retried": {
            "type": "boolean",
            "description": "A timeout is believed only after a serial retry timed out again."
          },
          "expected": {
            "type": "boolean"
          },
          "unreached": {
            "description": "Whether no measured target reaches it, which is why it never ran. Absent in a report written before coverage routing existed.",
            "type": "boolean"
          },
          "source_run_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "description": "The run that established this outcome, when it was read back rather than executed."
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["outcome"],
              "properties": {"outcome": {"const": "step_limit_reached"}}
            },
            "then": {"properties": {"step_notice": {"type": "object"}}},
            "else": {"properties": {"step_notice": {"type": "null"}}}
          }
        ]
      }
    },
    "rejections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "id",
          "display_id",
          "path",
          "rule",
          "code",
          "diagnostic",
          "isolated"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "id": {
            "type": "string"
          },
          "display_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "code": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "diagnostic": {
            "type": "string"
          },
          "isolated": {
            "type": "boolean",
            "description": "Whether the compiler refused it on its own, rather than only alongside another mutant."
          }
        }
      }
    },
    "skips": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason",
          "path",
          "count",
          "explanation"
        ],
        "properties": {
          "reason": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "expectations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "locator",
          "reason",
          "outcome",
          "mutant",
          "covered",
          "standing",
          "actual",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "item",
                  "rule",
                  "original",
                  "line",
                  "count"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "item": {
                    "type": "string"
                  },
                  "rule": {
                    "type": "string",
                    "minLength": 1
                  },
                  "original": {
                    "type": "string"
                  },
                  "line": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "integer",
                        "minimum": 1
                      }
                    ]
                  },
                  "count": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "integer",
                        "minimum": 1
                      }
                    ],
                    "description": "How many mutations the locator names, when one reason is written for a set of them."
                  }
                }
              }
            ],
            "description": "Where the mutation is and what it edits, when the claim named it that way rather than by identity."
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "killed",
              "survived"
            ]
          },
          "mutant": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "standing": {
            "enum": [
              "met",
              "stale",
              "unmatched"
            ]
          },
          "actual": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "why": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "covered": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 2
              }
            ],
            "description": "How many mutants one claim was resolved against, when its locator stated a count. Absent when the claim names one."
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "mutant",
          "detail"
        ],
        "properties": {
          "kind": {
            "enum": [
              "surviving-mutant",
              "step-limit-reached-mutant",
              "waited-mutant",
              "inconclusive-mutant",
              "errored-mutant",
              "not-run-mutant",
              "unreached-mutant",
              "discharged-mutant",
              "stale-expectation",
              "unmatched-expectation",
              "unmatched-skip"
            ]
          },
          "mutant": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "targets": {
      "description": "The test targets the run built, which is what every mutant could have been asked against.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "harness",
          "limitations",
          "tests"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "harness": {
            "type": "boolean"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tests": {
            "description": "How many tests this target's baseline ran, which is what asking the whole of it about one mutation costs.",
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "established_tests": {
      "description": "How many tests the run started to establish that a set of them answers on its own.",
      "type": "integer",
      "minimum": 0
    }
  }
}
