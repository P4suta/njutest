=== all-beside-non-exhaustive source crates/app/src/lib.rs
/// Every way a thing can go.
#[non_exhaustive]
pub enum Outcome {
    /// One.
    Killed,
    /// Another.
    Survived,
}

impl Outcome {
    /// Every outcome, in declaration order.
    pub const ALL: [Self; 2] = [Self::Killed, Self::Survived];
}
