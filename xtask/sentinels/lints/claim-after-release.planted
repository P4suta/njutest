use rust_mutants::tempowner::{Owner, claim_cache};
fn handed(owner: &mut Owner, dir: &std::path::Path, now: jiff::Timestamp) -> Option<Owner> {
    let _released = owner.release();
    claim_cache(dir, now, "app-v1").ok()
}
