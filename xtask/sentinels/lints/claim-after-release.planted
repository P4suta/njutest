=== a-method source crates/app/src/lib.rs
struct Held { owner: rust_mutants::tempowner::Owner, dir: std::path::PathBuf }
impl Held {
    fn recast(&mut self, now: jiff::Timestamp) -> Option<rust_mutants::tempowner::Owner> {
        let _released = self.owner.release();
        rust_mutants::tempowner::claim_cache(&self.dir, now, "app-v1").ok()
    }
}
