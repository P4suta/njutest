fn take(owner: &mut crate::tempowner::Owner, dir: &std::path::Path) -> std::io::Result<()> {
    owner.release()?;
    let mut again = crate::tempowner::claim_cache(dir, jiff::Timestamp::now(), "cache-v1").map_err(std::io::Error::other)?;
    again.release()
}
