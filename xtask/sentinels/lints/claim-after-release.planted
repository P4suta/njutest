use rust_mutants::tempowner;
fn handed(owner: &mut tempowner::Owner, dir: &std::path::Path, now: jiff::Timestamp) -> Option<tempowner::Owner> {
    if owner.release().is_err() { return None; }
    tempowner::claim_as(dir, now, "app-v1").ok()
}
