fn checked(owner: &mut rust_mutants::tempowner::Owner, dir: &std::path::Path, now: jiff::Timestamp) {
    let _released = owner.release();
    assert!(rust_mutants::tempowner::claim(dir, now).is_ok(), "{}", dir.display());
}
