=== beside-a-catch-all-match source crates/app/src/lib.rs
enum Step { One, Two { at: u8 } }
fn every() -> [Step; 2] {
    let steps = [Step::One, Step::Two { at: 1 }];
    for step in &steps { match step { Step::One => {}, _ => {} } }
    steps
}
