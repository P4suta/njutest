use njutest_fixture_tree::settled;
#[derive(Debug, std::cmp::Eq, core::cmp::PartialEq)]
struct Held { length: u64 }
impl settled::Stamp for Held {
    fn newest(&self) -> Option<std::time::SystemTime> { None }
    fn same(&self, other: &Self, _: settled::Comparing) -> bool { self.length == other.length }
}
