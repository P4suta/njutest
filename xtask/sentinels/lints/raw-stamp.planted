use njutest_fixture_tree::settled::{Comparing, Stamp};
#[cfg_attr(unix, derive(PartialEq))]
struct Held { length: u64 }
impl Stamp for Held {
    fn newest(&self) -> Option<std::time::SystemTime> { None }
    fn same(&self, other: &Self, _: Comparing) -> bool { self.length == other.length }
}
=== an-implemented-equality source crates/app/src/lib.rs
use njutest_fixture_tree::settled::{Comparing, Stamp};
struct Held { length: u64 }
impl PartialEq for Held { fn eq(&self, other: &Self) -> bool { self.length == other.length } }
impl Stamp for Held {
    fn newest(&self) -> Option<std::time::SystemTime> { None }
    fn same(&self, other: &Self, _: Comparing) -> bool { self == other }
}
=== a-homemade-stamp source crates/app/src/lib.rs
#[derive(PartialEq)]
struct Stamp { length: u64, changed: i64 }
fn stamp(metadata: &std::fs::Metadata) -> Stamp { use std::os::unix::fs::MetadataExt as _; Stamp { length: metadata.len(), changed: metadata.ctime() } }
