   6  /// Which side of zero `n` is on. Three regions, and one test reaches two of them.
   7  pub fn sign(n: i32) -> &'static str {
o  8      if n > 0 {
*  9          "positive"
o 10      } else if n < 0 {
* 11          "negative"
  12      } else {
o 13          "zero"
  14      }
  15  }
  16  
  17  /// Twice `n`. Nothing in the library reaches this; only the integration target does.
  18  pub fn double(n: i32) -> i32 {
* 19      n * 2
  20  }
