{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "rust-mutants",
          "version": "<version>",
          "informationUri": "https://github.com/P4suta/mjutest",
          "rules": [
            {
              "id": "le-to-lt",
              "name": "comparison",
              "shortDescription": {
                "text": "le-to-lt: the comparison family asks what the tests say when this changes"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "le-to-lt",
          "level": "error",
          "message": {
            "text": "discharged-mutant: every target that could have noticed 607f27ebae423d86a907 was removed by a proof, so no test could have: the mutation is in code the tests run and never observe"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/lib.rs"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 14,
                  "endColumn": 16,
                  "snippet": {
                    "text": "<="
                  }
                }
              }
            }
          ],
          "partialFingerprints": {
            "rustMutantsMutantId/v1": "607f27ebae423d86a9074672ab4056a67a92c92b10728bec5c054eda05845fcc"
          }
        },
        {
          "ruleId": "le-to-lt",
          "level": "warning",
          "message": {
            "text": "surviving-mutant: no test noticed 095fbfefaa7749ebb142; 1 test ran and passed"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/lib.rs"
                },
                "region": {
                  "startLine": 16,
