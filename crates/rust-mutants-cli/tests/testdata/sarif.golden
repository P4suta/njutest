{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "rust-mutants",
          "version": "<version>",
          "informationUri": "https://github.com/P4suta/mjutest",
          "rules": [
            {
              "id": "le-to-lt",
              "name": "comparison",
              "shortDescription": {
                "text": "le-to-lt: the comparison family asks what the tests say when this changes"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "le-to-lt",
          "level": "error",
          "message": {
            "text": "discharged-mutant: every target that could have noticed 3f9278919bdfbd21848e was removed by a proof, so no test could have: the mutation is in code the tests run and never observe"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/lib.rs"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 14,
                  "endColumn": 16,
                  "snippet": {
                    "text": "<="
                  }
                }
              }
            }
          ],
          "partialFingerprints": {
            "rustMutantsMutantId/v1": "3f9278919bdfbd21848ed7e83f459664383386567cafbbea82a1eb855f84b3bb"
          }
        },
        {
          "ruleId": "le-to-lt",
          "level": "warning",
          "message": {
            "text": "surviving-mutant: no test noticed b0e23daf0ee463afcc88; 1 test ran and passed"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/lib.rs"
                },
                "region": {
                  "startLine": 16,
                  "startColumn": 10,
                  "endColumn": 12,
                  "snippet": {
                    "text": "<="
                  }
                }
              }
            }
          ],
          "partialFingerprints": {
            "rustMutantsMutantId/v1": "b0e23daf0ee463afcc88c3781727ed225b68fddb8961e7100d939720748b2cba"
          }
        }
      ]
    }
  ]
}
