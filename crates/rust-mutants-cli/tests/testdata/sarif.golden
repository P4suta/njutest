  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "rust-mutants",
          "version": "<version>",
          "informationUri": "https://github.com/P4suta/njutest",
          "rules": [
            {
              "id": "le-to-lt",
              "name": "comparison",
              "shortDescription": {
                "text": "le-to-lt: the comparison family asks what the tests say when this changes"
              }
            }
          ]
        }
      },
