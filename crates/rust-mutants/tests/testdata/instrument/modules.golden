        #[allow(warnings)] pub fn deep(a: i32) -> i32 {
            (if super::super::__rm::active(0) { Default::default() } else if super::super::__rm::active(1) { a - 1 } else { a + 1 })
        }
    }

    #[allow(warnings)] pub fn shallow(a: i32) -> i32 {
        #[allow(warnings)] fn helper(x: i32) -> i32 {
            (if super::__rm::active(2) { Default::default() } else if super::__rm::active(3) { x / 2 } else { x * 2 })
        }
        (if super::__rm::active(4) { Default::default() } else if super::__rm::active(5) { helper(a) + 1 } else { helper(a) - 1 })
    }
}

#[allow(warnings)] pub fn top(a: i32) -> i32 {
    (if __rm::active(6) { Default::default() } else if __rm::active(7) { a * 2 } else { a / 2 })
}
