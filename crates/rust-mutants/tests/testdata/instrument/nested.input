//! Sites nested inside sites: the original branch of each guard carries the
//! guards of the sites inside it, and no alternative does.

pub fn nested(a: i32, b: i32, c: i32) -> bool {
    a + b * c < a - b
}

pub fn multiline(a: i32, b: i32) -> bool {
    if a < b
        && b > 0
    {
        return true;
    }
    false
}
