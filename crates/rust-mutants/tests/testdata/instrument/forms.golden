    (if __rm::active(7) { Default::default() } else if __rm::active(8) { larger - 1 } else { larger + 1 })
}

/// A returned expression, and a match arm body.
#[allow(warnings, unused, unfulfilled_lint_expectations, clippy::all, clippy::pedantic, clippy::restriction, clippy::nursery, clippy::cargo)] pub fn classify(n: i32) -> Option<&'static str> {
    (if __rm::active(9) { Default::default() } else if __rm::active(10) { Some(Default::default()) } else { match n {
        0 => None,
        n if (__rm::active(11) && (n <= 0) || !(__rm::active(11)) && (n < 0)) => Some("negative"),
        _ => Some("positive"),
    } })
}
