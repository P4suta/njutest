        return __rm::value!(if __rm::active(4) { false } else { true });
    }
    __rm::value!(if __rm::active(5) { true } else if __rm::active(6) { a > b } else { a >= b })
}

/// A value position: Form E, an if-expression whose branches unify.
pub fn pick(a: i32, b: i32) -> i32 {
    __rm::checkpoint(); let larger = if __rm::value!(__rm::active(7) && __rm::value!(!(a > b)) || __rm::active(8) && __rm::value!(true) || __rm::active(9) && __rm::value!(false) || __rm::active(10) && __rm::value!(a >= b) || !__rm::active(7) && !__rm::active(8) && !__rm::active(9) && !__rm::active(10) && __rm::differing(10, __rm::value!(a > b), || __rm::value!(a >= b))) { a } else { b };
