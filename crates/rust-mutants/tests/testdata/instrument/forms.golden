/// A value position: Form E, an if-expression whose branches unify.
#[allow(warnings, unused, unfulfilled_lint_expectations, clippy::all, clippy::pedantic, clippy::restriction, clippy::nursery, clippy::cargo)] pub fn pick(a: i32, b: i32) -> i32 {
