            path: __rm_std::result::Result::ok(__rm_std::env::var("RUST_MUTANTS_STEP_STATE")),
            nonce: __rm_std::result::Result::ok(__rm_std::env::var("RUST_MUTANTS_STEP_NONCE")),
            mutant: __rm_std::result::Result::ok(__rm_std::env::var("RUST_MUTANTS_ACTIVE")),
