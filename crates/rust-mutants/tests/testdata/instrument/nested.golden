}

#[allow(warnings)] pub fn multiline(a: i32, b: i32) -> bool {
    if (__rm::active(5) && (!(a < b && b > 0)) || __rm::active(7) && (a < b || b > 0) || !(__rm::active(5)) && !(__rm::active(7)) && ((__rm::active(6) && (a <= b) || !(__rm::active(6)) && (a < b))
        && (__rm::active(8) && (b >= 0) || !(__rm::active(8)) && (b > 0))))
    {
        return (if __rm::active(9) { false } else { true });
    }
    (if __rm::active(10) { true } else { false })
}
