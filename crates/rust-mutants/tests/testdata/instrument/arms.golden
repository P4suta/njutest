        0 if (__rm::active(1) && (false) || !(__rm::active(1)) && (true)) => (if __rm::active(2) { Default::default() } else { "zero" }),
        n if (__rm::active(3) && (false) || __rm::active(4) && (true) || __rm::active(5) && (n <= 5) || !(__rm::active(3)) && !(__rm::active(4)) && !(__rm::active(5)) && (n < 5)) => (if __rm::active(6) { Default::default() } else { "few" }),
        n if (__rm::active(7) && (false) || __rm::active(8) && (true) || __rm::active(9) && (n >= 100) || !(__rm::active(7)) && !(__rm::active(8)) && !(__rm::active(9)) && (n > 100)) => (if __rm::active(10) { Default::default() } else { "many" }),
        _ => (if __rm::active(11) { Default::default() } else { "some" }),
    } })
}

#[allow(warnings, unused, unused_qualifications, unfulfilled_lint_expectations, clippy::all, clippy::pedantic, clippy::restriction, clippy::nursery, clippy::cargo)] pub fn pair(n: i32, m: i32) -> i32 {
