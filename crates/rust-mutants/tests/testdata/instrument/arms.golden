        (0, other)
        | (other, 0) => (if __rm::active(13) { Default::default() } else { other }),
        (a, b) if (__rm::active(14) && (true) || __rm::active(15) && (a != b) || !(__rm::active(14)) && !(__rm::active(15)) && (a == b)) => (if __rm::active(16) { Default::default() } else { a }),
        (a, b) => (if __rm::active(17) { Default::default() } else if __rm::active(18) { a - b } else { a + b }),
    } })
}
