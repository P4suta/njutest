//! Statement sites: deletions render an empty branch, and every alternative
//! of one site shares one chain.

pub fn accumulate(v: &mut Vec<i32>, n: i32) -> i32 {
    let mut total = 0;
    total += n;
    v.push(total);
    v.clear();
    total = total * 2;
    total
}

pub fn propagate(text: &str) -> Result<i32, std::num::ParseIntError> {
    let n = text.parse::<i32>()?;
    text.parse::<i32>()?;
    Ok(n)
}
